{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    // Base config - https://github.com/giantswarm/renovate-presets/blob/main/default.json5
    "github>giantswarm/renovate-presets:default.json5",
  ],
  // Track standalone `tag:` fields in values.yaml files that are annotated with
  // a Renovate inline comment. The preset's `registry:` patterns do not cover
  // the `tag:` key name, so this custom manager is needed.
  //
  // Usage in values.yaml:
  //   # renovate: datasource=docker depName=gsoci.azurecr.io/giantswarm/strimzi/kafka-bridge
  //   tag: "0.33.1"
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["^helm/.+/values\\.yaml$"],
      "matchStrings": [
        "renovate: datasource=(?<datasource>[^ ]+) depName=(?<depName>[^\n]+)\n\\s+tag: \"(?<currentValue>[^\"]+)\"",
      ],
    },
    // Track the upstream Helm chart version pinned in Makefile.custom.mk.
    // The chart is vendored via `helm pull` (driven by UPSTREAM_CHART_VERSION)
    // rather than declared as a Chart.yaml dependency, so Renovate's helmv3
    // manager cannot see it.
    {
      "customType": "regex",
      "managerFilePatterns": ["^Makefile\\.custom\\.mk$"],
      "matchStrings": [
        "UPSTREAM_CHART_REPO := (?<registryUrl>\\S+)\\s+UPSTREAM_CHART_NAME := (?<depName>\\S+)\\s+UPSTREAM_CHART_VERSION := (?<currentValue>\\S+)",
      ],
      "datasourceTemplate": "helm",
    },
  ],
}
